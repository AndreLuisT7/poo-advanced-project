# Copie este arquivo como application-local.properties e preencha.
# O arquivo real esta no .gitignore e nunca deve ser versionado.

# Banco PostgreSQL (Neon)
spring.datasource.url=jdbc:postgresql://SEU_HOST.neon.tech/SEU_BANCO?sslmode=require
spring.datasource.username=SEU_USUARIO
spring.datasource.password=SUA_SENHA

# Envio de e-mail (senha de aplicativo do Gmail, nao a senha da conta)
spring.mail.username=SEU_EMAIL@gmail.com
spring.mail.password=SUA_SENHA_DE_APP

# Envio de SMS (Vonage)
vonage.api.key=SUA_CHAVE
vonage.api.secret=SEU_SEGREDO
