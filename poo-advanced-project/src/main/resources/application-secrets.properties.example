# Copie este arquivo como application-secrets.properties e preencha.
# Ele e lido em qualquer perfil (demo, local, producao) e esta no .gitignore.

# Envio de e-mail: use uma senha de aplicativo do Gmail, nao a senha da conta
spring.mail.username=SEU_EMAIL@gmail.com
spring.mail.password=SUA_SENHA_DE_APP

# Envio de SMS (Vonage)
vonage.api.key=SUA_CHAVE
vonage.api.secret=SEU_SEGREDO
